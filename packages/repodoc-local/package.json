{
  "name": "repodoc-local",
  "version": "0.1.0",
  "description": "Local-first AI bug fixer and guardrails. Code never leaves your machine. Powered by Gemma 4.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "repodoc": "dist/cli.js",
    "repodoc-local": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "prompts",
    "repodoc.example.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/cli.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusky-lms/repoDoc.git",
    "directory": "packages/repodoc-local"
  },
  "keywords": [
    "local-first",
    "gemma",
    "ollama",
    "code-review",
    "privacy",
    "guardrails"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
